# Normalise line endings in the repository.
* text=auto

# Server-side files must always have LF endings, whatever the client's
# core.autocrlf: bash and nginx reject CRLF.
*.sh        text eol=lf
*.template  text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf

# Binary assets.
*.webp binary
*.png  binary
*.jpg  binary
*.pdf  binary
