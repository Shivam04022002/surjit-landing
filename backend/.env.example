# Surjit Finance Landing Page (SurjitLanding) — API configuration.
# PLACEHOLDERS ONLY. Never commit a real .env.
#
# Local development: copy to backend/.env.
# Server: the only real copy is /var/www/surjit-landing/shared/.env (mode 600,
# owner surjit-landing); each release's backend/.env is a symlink to it,
# created by deploy/scripts/deploy.sh. Never copy values from SurjitWeb's
# environment, and never point any of these at SurjitWeb's resources.

# Production: NODE_ENV=production
NODE_ENV=development

# Loopback only. In production the API refuses to start on any other address,
# and the deploy script requires PORT=5050. Only Nginx reaches the API.
HOST=127.0.0.1
PORT=5050

# The landing page's OWN database, `surjit_landing`, with its own
# least-privilege user (readWrite on surjit_landing only). The deploy script
# refuses any URI that does not name surjit_landing.
MONGODB_URI=mongodb://landing_app:CHANGE_ME@127.0.0.1:27017/surjit_landing?authSource=surjit_landing

# Exact browser origins allowed to call the API (comma separated).
# Production: https://LANDING_DOMAIN (http:// is refused in production).
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (Nginx = 1).
TRUST_PROXY=1

# Loan amount bounds in rupees. The maximum is a business decision — confirm it.
LOAN_MIN_AMOUNT=10000
LOAN_MAX_AMOUNT=5000000

# PIN-code lookup provider (public, no credentials).
PINCODE_API_BASE_URL=https://api.postalpincode.in/pincode
PINCODE_TIMEOUT_MS=5000

# Per-IP rate limits (optional; defaults shown).
LEAD_RATE_LIMIT_WINDOW_MS=3600000
LEAD_RATE_LIMIT_MAX=10
PINCODE_RATE_LIMIT_WINDOW_MS=900000
PINCODE_RATE_LIMIT_MAX=60
ANALYTICS_RATE_LIMIT_WINDOW_MS=900000
ANALYTICS_RATE_LIMIT_MAX=300

# Anonymous analytics events expire after this many days.
ANALYTICS_RETENTION_DAYS=365
