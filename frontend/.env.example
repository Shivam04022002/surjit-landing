# Surjit Finance Landing Page — frontend build settings.
# Vite embeds VITE_* values in the public bundle: never put a secret here.

# API base. Leave as /api when Nginx serves the API on the same domain (recommended).
VITE_API_BASE_URL=/api

# Fallback loan bounds, used only if /api/leads/config cannot be reached.
# Keep in step with the backend's LOAN_MIN_AMOUNT / LOAN_MAX_AMOUNT.
VITE_LOAN_MIN_AMOUNT=10000
VITE_LOAN_MAX_AMOUNT=5000000

# First-party anonymous analytics. Set to false to send no events at all.
VITE_ANALYTICS_ENABLED=true
